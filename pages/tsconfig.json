{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "typeRoots": ["../dependencies/node_modules/@types"],
    "paths": {
      "react": ["../dependencies/node_modules/@types/react"],
      "react/*": ["../dependencies/node_modules/@types/react/*"],
      "react-dom": ["../dependencies/node_modules/@types/react-dom"],
      "react-dom/*": ["../dependencies/node_modules/@types/react-dom/*"],
      "lucide-react": ["../dependencies/node_modules/lucide-react"]
    }
  },
  "include": ["./*.tsx", "../packages/portfolio/src/**/*.tsx", "../packages/portfolio/src/**/*.ts"]
}
